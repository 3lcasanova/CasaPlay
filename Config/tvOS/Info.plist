	<string>$(OMDB_API_KEY)</string>
	<key>OpenSubtitlesAPIKey</key>
	<string>$(OPENSUBTITLES_API_KEY)</string>
	<key>TMDBAPIKey</key>
	<string>$(TMDB_API_KEY)</string>
	<key>TVDBAPIKey</key>
	<string>$(TVDB_API_KEY)</string>
	<key>UIUserInterfaceStyle</key>
	<string>Dark</string>
