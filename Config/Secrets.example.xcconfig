//
// Copy this file to Config/Secrets.xcconfig and fill in your keys.
// Secrets.xcconfig is ignored by git, so the keys never reach GitHub.
//   TMDB (search + posters):  https://www.themoviedb.org/settings/api  (read access token)
//   OMDb (IMDb ratings):       https://www.omdbapi.com/apikey.aspx
//   OpenSubtitles:             https://www.opensubtitles.com/en/consumers

TMDB_API_KEY = your-tmdb-read-access-token
OMDB_API_KEY = your-omdb-key
OPENSUBTITLES_API_KEY = your-opensubtitles-key
