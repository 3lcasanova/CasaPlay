//
// Copy this file to Config/Secrets.xcconfig and fill in your keys.
// Secrets.xcconfig is ignored by git, so the keys never reach GitHub.
//   TMDB (posters, shows):     https://www.themoviedb.org/settings/api  (read access token or API key)
//   TheTVDB (episodes):        https://thetvdb.com/dashboard/account/apikey  (project API key)
//   OMDb (IMDb ratings):       https://www.omdbapi.com/apikey.aspx
//   OpenSubtitles:             https://www.opensubtitles.com/en/consumers

TMDB_API_KEY = your-tmdb-read-access-token
TVDB_API_KEY = your-thetvdb-project-api-key
OMDB_API_KEY = your-omdb-key
OPENSUBTITLES_API_KEY = your-opensubtitles-key

// Your own add-on links, separated by spaces. Leave the https:// off: two slashes in a row start a comment in .xcconfig files.
// Easier: run  PERSONAL_ADDON_URL='https://…/manifest.json' bash Scripts/setup-addon.sh
PERSONAL_ADDON_URL = mediafusion.example.com/your-link/manifest.json

// Your own IPTV (Xtream Codes) login. Leave the https:// off. Easier: run  bash Scripts/setup-xtream.sh
XTREAM_SERVER = iptv.example.org
XTREAM_USERNAME = your-username
XTREAM_PASSWORD = your-password
